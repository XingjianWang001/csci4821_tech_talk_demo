extends layout

block vars
    - var pageWidth = 'narrow'

block content
    .auth-container
        h1 Log In

        form.auth-form(action="/login" method="POST")
            .form-group
                label(for="username") Username
                input#username(type="text" name="username" value=username autocomplete="username" required)

            .form-group
                label(for="password") Password
                input#password(type="password" name="password" autocomplete="current-password" required)

            button.btn.btn-primary(type="submit") Log In

        .auth-footer
            p Don't have an account? #[a(href="/register") Register]
