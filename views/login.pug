extends layout

block vars
    - var pageWidth = 'narrow'

block content
    .auth-container
        h1 Log In

        form.auth-form(action="/login" method="POST")
            - var errs = errors || {}
            +field({id: 'username', label: 'Username', value: username, autocomplete: 'username', error: errs.username, autofocus: errs.username})
            +field({id: 'password', label: 'Password', type: 'password', autocomplete: 'current-password', error: errs.password, autofocus: errs.password && !errs.username})

            button.btn.btn-primary(type="submit") Log In

        .auth-footer
            p Don't have an account? #[a(href="/register") Register]
