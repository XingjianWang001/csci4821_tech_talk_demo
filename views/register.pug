extends layout

block vars
    - var pageWidth = 'narrow'

block content
    .auth-container
        h1 Register

        form.auth-form(action="/register" method="POST")
            - var errs = errors || {}
            +field({id: 'username', label: 'Username', value: username, autocomplete: 'username', error: errs.username, autofocus: errs.username})
            +field({id: 'password', label: 'Password', type: 'password', autocomplete: 'new-password', error: errs.password, autofocus: errs.password && !errs.username})
            +field({id: 'password2', label: 'Confirm Password', type: 'password', autocomplete: 'new-password', error: errs.password2, autofocus: errs.password2 && !errs.username && !errs.password})

            button.btn.btn-primary(type="submit") Register

        .auth-footer
            p Already have an account? #[a(href="/login") Log in]
