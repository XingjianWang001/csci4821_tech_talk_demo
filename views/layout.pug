doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= title
        link(rel="stylesheet" href="/css/main.css")
    body(data-clear-draft=clearDraft)
        - var current = (href) => currentPath === href ? 'page' : undefined
        header.navbar
            nav.navbar-inner(aria-label="Main")
                a.nav-brand(href="/" aria-current=current('/')) Question Box Blog
                .nav-right
                    if user
                        span.nav-user
                            span.welcome Welcome, #{user.username}!
                            if user.isAdmin
                                span.admin-badge Admin
                        a.nav-link(href="/post/new" aria-current=current('/post/new')) New Question Box
                        a.nav-link(href="/logout") Log Out
                    else
                        a.nav-link(href=loginHref aria-current=current('/login')) Log In
                        a.nav-link(href=registerHref aria-current=current('/register')) Register

        main.page
            if message
                .message(class=messageType role=messageType === 'error' ? 'alert' : 'status')= message
            .content(class=pageWidth === 'narrow' ? 'content--narrow' : undefined)
                block content

        footer.footer
            .footer-inner
                p &copy; #{new Date().getFullYear()} Question Box Blog · CSCI4131 Final Project
                p Made with love by Shiba

        script(src="/js/main.js")
        block scripts
